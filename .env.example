# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# gitignored and never committed.
#
# Optional: the app works fully offline with no cloud project configured at
# all — these only enable cross-device sync and the private dev telemetry
# view. See supabase/migrations/0001_init.sql for the schema these expect.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
